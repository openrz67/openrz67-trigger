(version 1)

# USB1's two 0.7 mm locating-peg holes come from the LCSC footprint for C2765186 and
# sit 0.171 mm from USB1's own pads 1/12. The rev-1 board was fabricated with exactly
# this geometry, so accept it for USB1's pads only. Everything else (zones, tracks,
# other footprints) keeps the board-wide 0.175 mm hole clearance, and the pours are
# held at 0.25 mm like the fabricated rev 1 (JLCPCB's NPTH-to-copper minimum is 0.2).
(rule "USB1 locating pegs vs USB1 pads"
	(condition "A.Reference == 'USB1' && A.Pad_Type == 'NPTH, mechanical' && B.Reference == 'USB1'")
	(constraint hole_clearance (min 0.17mm))
)
(rule "USB1 locating pegs vs zones"
	(condition "A.Reference == 'USB1' && A.Pad_Type == 'NPTH, mechanical' && B.Type == 'Zone'")
	(constraint hole_clearance (min 0.25mm))
)
